diff --git a/node_modules/react-native-enriched-html/ios/styles/CharacterStyleBase.mm b/node_modules/react-native-enriched-html/ios/styles/CharacterStyleBase.mm
new file mode 100644
index 0000000..804221b
--- /dev/null
+++ b/node_modules/react-native-enriched-html/ios/styles/CharacterStyleBase.mm
@@ -0,0 +1,177 @@
+#import "CharacterStyleBase.h"
+#import "CssStyleUtils.h"
+#import "EnrichedTextInputView.h"
+#import "StyleHeaders.h"
+
+@implementation CharacterStyleBase
+
+- (NSString *)visualKey {
+  return [self getKey];
+}
+
+- (Class)valueClass {
+  return [NSObject class];
+}
+
+- (id)valueFromCssString:(NSString *)css {
+  return nil;
+}
+
+- (NSString *)cssStringFromValue:(id)value {
+  return nil;
+}
+
+- (BOOL)isParagraph {
+  return NO;
+}
+
+- (NSRange)clamped:(NSRange)range {
+  NSUInteger length = self.host.textView.textStorage.string.length;
+  if (range.location > length) {
+    return NSMakeRange(length, 0);
+  }
+  return NSMakeRange(range.location, MIN(range.length, length - range.location));
+}
+
+- (id)valueAt:(NSUInteger)location {
+  NSUInteger length = self.host.textView.textStorage.string.length;
+  if (location >= length) {
+    return nil;
+  }
+  id value = [self.host.textView.textStorage attribute:[self getKey]
+                                               atIndex:location
+                                        effectiveRange:nil];
+  return [value isKindOfClass:[self valueClass]] ? value : nil;
+}
+
+// 默认实现比较的是 @"AnyValue"，这里改成「是不是本样式存的那种值」
+- (BOOL)styleCondition:(id)value range:(NSRange)range {
+  return value != nil && [value isKindOfClass:[self valueClass]];
+}
+
+- (void)applyStyling:(NSRange)range {
+  NSRange actual = [self clamped:range];
+  if (actual.length == 0) {
+    return;
+  }
+  id value = [self valueAt:actual.location];
+  if (value == nil) {
+    return;
+  }
+  [self.host.textView.textStorage addAttribute:[self visualKey]
+                                         value:value
+                                         range:actual];
+}
+
+- (void)addValue:(id)value
+           range:(NSRange)range
+      withTyping:(BOOL)withTyping
+  withDirtyRange:(BOOL)withDirtyRange {
+  NSRange actual = [self clamped:range];
+
+  if (actual.length == 0) {
+    // 没有选中内容：只让后续输入带上这个值
+    if (withTyping) {
+      [self addTypingWithValue:(NSString *)value];
+    }
+    return;
+  }
+
+  [self.host.textView.textStorage addAttribute:[self getKey]
+                                         value:value
+                                         range:actual];
+  [self applyStyling:actual];
+
+  if (withTyping) {
+    [self addTypingWithValue:(NSString *)value];
+  }
+  if (withDirtyRange) {
+    [self.host.attributesManager addDirtyRange:actual];
+  }
+}
+
+- (void)clearValueInRange:(NSRange)range {
+  NSRange actual = [self clamped:range];
+
+  if (actual.length == 0) {
+    // 光标收起时不动已有内容，只把 typing 上的样式摘掉
+    [self removeTyping];
+    return;
+  }
+
+  [self.host.textView.textStorage removeAttribute:[self getKey] range:actual];
+  [self resetStyling:actual];
+  [self removeTyping];
+}
+
+// 子类覆盖：把视觉属性恢复成默认值
+- (void)resetStyling:(NSRange)range {
+  [self.host.textView.textStorage removeAttribute:[self visualKey] range:range];
+}
+
+- (void)addTypingWithValue:(NSString *)value {
+  [super addTypingWithValue:value];
+
+  NSMutableDictionary *attributes =
+      [self.host.textView.typingAttributes mutableCopy];
+  [self applyValueToTypingAttrs:attributes value:(id)value];
+  self.host.textView.typingAttributes = attributes;
+}
+
+- (void)applyValueToTypingAttrs:(NSMutableDictionary *)attributes
+                          value:(id)value {
+  attributes[[self visualKey]] = value;
+}
+
+// dirty range 重算时会先重置成默认属性，再从这里把样式补回来
+- (void)reapplyFromStylePair:(StylePair *)pair {
+  NSRange range = [pair.rangeValue rangeValue];
+  [self.host.textView.textStorage addAttribute:[self getKey]
+                                         value:pair.styleValue
+                                         range:range];
+}
+
+- (AttributeEntry *)getEntryIfPresent:(NSRange)range {
+  if (![self detect:range]) {
+    return nullptr;
+  }
+
+  id value = [self valueAt:range.location];
+  if (value == nil) {
+    return nullptr;
+  }
+
+  AttributeEntry *entry = [[AttributeEntry alloc] init];
+  entry.key = [self getKey];
+  entry.value = value;
+  return entry;
+}
+
+// 命令入口：CSS 字符串进来，解析后铺到选区
+- (void)applyCssValue:(NSString *)css range:(NSRange)range {
+  [self applyCssValue:css range:range withTyping:YES withDirtyRange:YES];
+}
+
+- (void)applyCssValue:(NSString *)css
+                range:(NSRange)range
+           withTyping:(BOOL)withTyping
+       withDirtyRange:(BOOL)withDirtyRange {
+  NSString *trimmed = [css
+      stringByTrimmingCharactersInSet:[NSCharacterSet whitespaceCharacterSet]];
+
+  if (trimmed.length == 0) {
+    [self clearValueInRange:range];
+    return;
+  }
+
+  id value = [self valueFromCssString:trimmed];
+  if (value == nil) {
+    return;
+  }
+  [self addValue:value
+           range:range
+      withTyping:withTyping
+  withDirtyRange:withDirtyRange];
+}
+
+@end
