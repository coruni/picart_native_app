diff --git a/node_modules/react-native-enriched-html/ios/extensions/CssStyleUtils.mm b/node_modules/react-native-enriched-html/ios/extensions/CssStyleUtils.mm
new file mode 100644
index 0000000..f0d9fec
--- /dev/null
+++ b/node_modules/react-native-enriched-html/ios/extensions/CssStyleUtils.mm
@@ -0,0 +1,179 @@
+#import "CssStyleUtils.h"
+
+@implementation CssStyleUtils
+
++ (NSString *)valueForProperty:(NSString *)property inStyle:(NSString *)style {
+  if (property.length == 0 || style.length == 0) {
+    return nil;
+  }
+
+  // 用简单的逐段扫描代替正则，避免属性名互相包含（color / background-color）
+  NSArray<NSString *> *declarations = [style componentsSeparatedByString:@";"];
+  for (NSString *declaration in declarations) {
+    NSRange colon = [declaration rangeOfString:@":"];
+    if (colon.location == NSNotFound) {
+      continue;
+    }
+    NSString *name = [[declaration substringToIndex:colon.location]
+        stringByTrimmingCharactersInSet:[NSCharacterSet
+                                            whitespaceCharacterSet]];
+    if ([name caseInsensitiveCompare:property] != NSOrderedSame) {
+      continue;
+    }
+    NSString *value = [[declaration substringFromIndex:colon.location + 1]
+        stringByTrimmingCharactersInSet:[NSCharacterSet
+                                            whitespaceCharacterSet]];
+    return value.length > 0 ? value : nil;
+  }
+
+  return nil;
+}
+
++ (CGFloat)channelFromComponent:(NSString *)component {
+  NSString *trimmed = [component
+      stringByTrimmingCharactersInSet:[NSCharacterSet whitespaceCharacterSet]];
+  if ([trimmed hasSuffix:@"%"]) {
+    CGFloat percent =
+        [[trimmed substringToIndex:trimmed.length - 1] floatValue];
+    return MAX(0, MIN(255, percent * 2.55f));
+  }
+  return MAX(0, MIN(255, [trimmed floatValue]));
+}
+
++ (UIColor *)colorFromCss:(NSString *)css {
+  if (css.length == 0) {
+    return nil;
+  }
+
+  NSString *value = [[css
+      stringByTrimmingCharactersInSet:[NSCharacterSet whitespaceCharacterSet]]
+      lowercaseString];
+
+  if ([value isEqualToString:@"transparent"] || [value isEqualToString:@"inherit"] ||
+      [value isEqualToString:@"initial"] || [value isEqualToString:@"unset"]) {
+    return nil;
+  }
+
+  if ([value hasPrefix:@"#"]) {
+    NSString *hex = [value substringFromIndex:1];
+
+    // #rgb / #rgba 展开成 #rrggbb / #rrggbbaa
+    if (hex.length == 3 || hex.length == 4) {
+      NSMutableString *expanded = [NSMutableString string];
+      for (NSUInteger i = 0; i < hex.length; i++) {
+        unichar c = [hex characterAtIndex:i];
+        [expanded appendFormat:@"%C%C", c, c];
+      }
+      hex = expanded;
+    }
+    if (hex.length != 6 && hex.length != 8) {
+      return nil;
+    }
+
+    unsigned long long raw = 0;
+    NSScanner *scanner = [NSScanner scannerWithString:hex];
+    if (![scanner scanHexLongLong:&raw]) {
+      return nil;
+    }
+
+    CGFloat alpha = 1.0;
+    if (hex.length == 8) {
+      alpha = ((raw >> 24) & 0xFF) / 255.0;
+      raw &= 0xFFFFFF;
+    }
+    return [UIColor colorWithRed:((raw >> 16) & 0xFF) / 255.0
+                           green:((raw >> 8) & 0xFF) / 255.0
+                            blue:(raw & 0xFF) / 255.0
+                           alpha:alpha];
+  }
+
+  if ([value hasPrefix:@"rgb"]) {
+    NSRange open = [value rangeOfString:@"("];
+    NSRange close = [value rangeOfString:@")" options:NSBackwardsSearch];
+    if (open.location == NSNotFound || close.location == NSNotFound ||
+        close.location <= open.location) {
+      return nil;
+    }
+    NSString *inner = [value substringWithRange:NSMakeRange(
+                                  open.location + 1,
+                                  close.location - open.location - 1)];
+    NSArray<NSString *> *parts = [inner componentsSeparatedByString:@","];
+    if (parts.count < 3) {
+      return nil;
+    }
+    CGFloat r = [self channelFromComponent:parts[0]];
+    CGFloat g = [self channelFromComponent:parts[1]];
+    CGFloat b = [self channelFromComponent:parts[2]];
+    CGFloat a = parts.count >= 4 ? [parts[3] floatValue] : 1.0;
+    return [UIColor colorWithRed:r / 255.0
+                           green:g / 255.0
+                            blue:b / 255.0
+                           alpha:MAX(0, MIN(1, a))];
+  }
+
+  // 常见颜色名，够覆盖外部粘贴进来的 HTML
+  NSDictionary<NSString *, NSString *> *named = @{
+    @"black" : @"#000000",
+    @"white" : @"#ffffff",
+    @"red" : @"#ff0000",
+    @"green" : @"#008000",
+    @"blue" : @"#0000ff",
+    @"yellow" : @"#ffff00",
+    @"orange" : @"#ffa500",
+    @"gray" : @"#808080",
+    @"grey" : @"#808080",
+    @"purple" : @"#800080"
+  };
+  NSString *mapped = named[value];
+  return mapped != nil ? [self colorFromCss:mapped] : nil;
+}
+
++ (NSString *)cssFromColor:(UIColor *)color {
+  if (color == nil) {
+    return nil;
+  }
+
+  CGFloat r = 0;
+  CGFloat g = 0;
+  CGFloat b = 0;
+  CGFloat a = 0;
+  if (![color getRed:&r green:&g blue:&b alpha:&a]) {
+    // 灰度色（UIColor.whiteColor 之类）走这套取色方式
+    CGFloat white = 0;
+    if (![color getWhite:&white alpha:&a]) {
+      return nil;
+    }
+    r = g = b = white;
+  }
+
+  return [NSString
+      stringWithFormat:@"#%02X%02X%02X", (int)lround(r * 255),
+                       (int)lround(g * 255), (int)lround(b * 255)];
+}
+
++ (CGFloat)fontSizeFromCss:(NSString *)css {
+  if (css.length == 0) {
+    return 0;
+  }
+
+  NSString *value = [[css
+      stringByTrimmingCharactersInSet:[NSCharacterSet whitespaceCharacterSet]]
+      lowercaseString];
+
+  // em / % 依赖父级字号，这里没有父级信息，直接忽略
+  if ([value hasSuffix:@"em"] || [value hasSuffix:@"%"]) {
+    return 0;
+  }
+  if ([value hasSuffix:@"px"] || [value hasSuffix:@"pt"]) {
+    value = [value substringToIndex:value.length - 2];
+  }
+
+  CGFloat parsed = [value floatValue];
+  return parsed > 0 ? parsed : 0;
+}
+
++ (NSString *)cssFromFontSize:(CGFloat)size {
+  return [NSString stringWithFormat:@"%dpx", (int)lround(size)];
+}
+
+@end
