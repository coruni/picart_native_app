+            .append(toCssColor(((BackgroundColorSpan) span).getBackgroundColor()));
+      } else if (span instanceof AbsoluteSizeSpan) {
+        if (style.length() > 0) {
+          style.append(';');
+        }
+        style.append("font-size:").append(((AbsoluteSizeSpan) span).getSize()).append("px");
+      }
+    }
+    return style.length() == 0 ? null : style.toString();
+  }
