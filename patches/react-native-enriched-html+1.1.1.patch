+  /** 把一段区间上的颜色 / 背景 / 字号合成成一个 style 属性，没有就返回 null。 */
+  private static String buildSpanStyleAttribute(Object[] spans) {
+    StringBuilder style = new StringBuilder();
+    for (Object span : spans) {
+      if (span instanceof ForegroundColorSpan) {
+        if (style.length() > 0) {
+          style.append(';');
+        }
+        style.append("color:").append(toCssColor(((ForegroundColorSpan) span).getForegroundColor()));
+      } else if (span instanceof BackgroundColorSpan) {
+        if (style.length() > 0) {
+          style.append(';');
+        }
+        style
