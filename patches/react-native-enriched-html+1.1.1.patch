diff --git a/node_modules/react-native-enriched-html/ios/interfaces/CharacterStyleBase.h b/node_modules/react-native-enriched-html/ios/interfaces/CharacterStyleBase.h
new file mode 100644
index 0000000..7c3fac2
--- /dev/null
+++ b/node_modules/react-native-enriched-html/ios/interfaces/CharacterStyleBase.h
@@ -0,0 +1,54 @@
+#pragma once
+#import "StyleBase.h"
+
+// 字符级的颜色 / 背景色 / 字号。
+//
+// 上游的样式都用「固定值」表示（Bold 存 @"AnyValue"），这三项的值每个区间
+// 都可能不同，所以 marker attribute 里直接存 UIKit 值（UIColor / NSNumber），
+// 再用 applyStyling: 把它展开成真正的渲染属性。
+@interface CharacterStyleBase : StyleBase
+
+/// 渲染时真正要写入的 attribute 名（子类覆盖）。
+- (NSString *)visualKey;
+
+/// marker 里存的值的类型（子类覆盖）。
+- (Class)valueClass;
+
+/// CSS 值 → UIKit 值（子类覆盖），解析失败返回 nil。
+- (id)valueFromCssString:(NSString *)css;
+
+/// UIKit 值 → CSS 值（子类覆盖），用于序列化 HTML。
+- (NSString *)cssStringFromValue:(id)value;
+
+/// 把值铺到 range 上；range 为空时只更新 typing 属性（跟随后续输入）。
+- (void)addValue:(id)value
+           range:(NSRange)range
+      withTyping:(BOOL)withTyping
+  withDirtyRange:(BOOL)withDirtyRange;
+
+/// 清掉 range 上的样式，恢复成默认外观。
+- (void)clearValueInRange:(NSRange)range;
+
+/// 取某个位置上的值，没有返回 nil。
+- (id)valueAt:(NSUInteger)location;
+
+/// 把 range 收进文本长度范围内。
+- (NSRange)clamped:(NSRange)range;
+
+/// 命令入口：CSS 字符串进来（空串表示清除），解析后铺到选区。
+- (void)applyCssValue:(NSString *)css range:(NSRange)range;
+
+/// 解析 HTML 时用：带上 typing / dirty range 的控制。
+- (void)applyCssValue:(NSString *)css
+                range:(NSRange)range
+           withTyping:(BOOL)withTyping
+       withDirtyRange:(BOOL)withDirtyRange;
+
+/// 子类覆盖：把视觉属性恢复成默认值。
+- (void)resetStyling:(NSRange)range;
+
+/// 子类覆盖：把 marker 值展开成 typing 属性。
+- (void)applyValueToTypingAttrs:(NSMutableDictionary *)attributes
+                          value:(id)value;
+
+@end
