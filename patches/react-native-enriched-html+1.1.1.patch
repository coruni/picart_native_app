new file mode 100644
index 0000000..ed95c51
--- /dev/null
+++ b/node_modules/react-native-enriched-html/ios/styles/FontSizeStyle.mm
@@ -0,0 +1,96 @@
+#import "CharacterStyleBase.h"
+#import "CssStyleUtils.h"
+#import "EnrichedTextInputView.h"
+#import "FontExtension.h"
+#import "StyleHeaders.h"
+
+@implementation FontSizeStyle
+
++ (StyleType)getType {
+  return FontSize;
+}
+
+- (NSString *)getKey {
+  return @"EnrichedFontSize";
+}
+
+- (NSString *)visualKey {
+  return NSFontAttributeName;
+}
+
+- (Class)valueClass {
+  return [NSNumber class];
+}
+
+- (id)valueFromCssString:(NSString *)css {
+  CGFloat size = [CssStyleUtils fontSizeFromCss:css];
+  return size > 0 ? @(size) : nil;
+}
+
+- (NSString *)cssStringFromValue:(id)value {
+  return [CssStyleUtils cssFromFontSize:[(NSNumber *)value doubleValue]];
+}
+
+// 字号改的是字体本身，不能像颜色那样直接塞 NSNumber，
+// 要在保留粗体 / 斜体等 traits 的前提下换 size
+- (void)applyStyling:(NSRange)range {
+  NSRange actual = [self clamped:range];
+  if (actual.length == 0) {
+    return;
+  }
+
+  NSNumber *size = [self valueAt:actual.location];
+  if (size == nil) {
+    return;
+  }
+
+  [self.host.textView.textStorage
+      enumerateAttribute:NSFontAttributeName
+                 inRange:actual
+                 options:0
+              usingBlock:^(id _Nullable value, NSRange fontRange,
+                           BOOL *_Nonnull stop) {
+                UIFont *font = (UIFont *)value;
+                if (font == nullptr) {
+                  return;
+                }
+                [self.host.textView.textStorage
+                    addAttribute:NSFontAttributeName
+                           value:[font setSize:[size doubleValue]]
+                           range:fontRange];
+              }];
+}
+
+- (void)resetStyling:(NSRange)range {
+  CGFloat primarySize = [[self.host.config primaryFontSize] doubleValue];
+  if (primarySize <= 0) {
+    return;
+  }
+
+  [self.host.textView.textStorage
+      enumerateAttribute:NSFontAttributeName
+                 inRange:range
+                 options:0
+              usingBlock:^(id _Nullable value, NSRange fontRange,
+                           BOOL *_Nonnull stop) {
+                UIFont *font = (UIFont *)value;
+                if (font == nullptr) {
+                  return;
+                }
+                [self.host.textView.textStorage
+                    addAttribute:NSFontAttributeName
+                           value:[font setSize:primarySize]
+                           range:fontRange];
+              }];
+}
+
+- (void)applyValueToTypingAttrs:(NSMutableDictionary *)attributes
+                          value:(id)value {
+  UIFont *font = (UIFont *)attributes[NSFontAttributeName];
+  if (font == nullptr) {
+    return;
+  }
+  attributes[NSFontAttributeName] = [font setSize:[(NSNumber *)value doubleValue]];
+}
+
+@end
