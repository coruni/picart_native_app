+- (void)scrollCursorToVisible {
+  __weak typeof(self) weakSelf = self;
+  dispatch_async(dispatch_get_main_queue(), ^{
+    RichTextInputView *strongSelf = weakSelf;
+    if (!strongSelf) {
+      return;
+    }
+    UITextView *textView = strongSelf->_textView;
+    if (!textView.window || !textView.scrollEnabled) {
+      return;
+    }
+    UITextRange *selectedTextRange = textView.selectedTextRange;
+    if (!selectedTextRange) {
+      return;
+    }
+
+    [textView layoutIfNeeded];
+    CGRect caretRect = [textView caretRectForPosition:selectedTextRange.end];
+    if (CGRectIsNull(caretRect) || CGRectIsEmpty(caretRect) ||
+        CGRectIsInfinite(caretRect)) {
+      return;
+    }
+
+    UIEdgeInsets contentInset = textView.adjustedContentInset;
+    CGFloat visibleHeight =
+        textView.bounds.size.height - contentInset.top - contentInset.bottom;
+    if (visibleHeight <= 0) {
+      return;
+    }
+
+    CGFloat minOffsetY = -contentInset.top;
+    CGFloat contentBottom =
+        MAX(textView.contentSize.height, CGRectGetMaxY(caretRect));
+    CGFloat maxOffsetY =
+        MAX(minOffsetY, contentBottom - textView.bounds.size.height +
+                            contentInset.bottom);
+    CGFloat currentOffsetY = textView.contentOffset.y;
+    CGFloat visibleTop = currentOffsetY + contentInset.top;
+    CGFloat visibleBottom = visibleTop + visibleHeight;
+
+    CGFloat targetOffsetY = currentOffsetY;
+    if (CGRectGetMaxY(caretRect) > visibleBottom) {
+      targetOffsetY =
+          CGRectGetMaxY(caretRect) - visibleHeight - contentInset.top;
+    } else if (CGRectGetMinY(caretRect) < visibleTop) {
+      targetOffsetY = CGRectGetMinY(caretRect) - contentInset.top;
+    }
